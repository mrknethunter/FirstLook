{
    admin off
}

:8080 {
    root * /srv
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-store"
    try_files {path} /index.html
    file_server
    log {
        output file /var/log/firstlook/web.jsonl {
            roll_size 10MiB
            roll_keep 10
        }
        format json
    }
}
